#!/usr/bin/env python3
"""Fake `gh` for evals: logs every call, answers from a canned-response map."""
import json
import os
import sys

argv = sys.argv[1:]
with open(os.environ["EVAL_GH_LOG"], "a") as f:
    f.write(json.dumps(argv) + "\n")
line = " ".join(argv)
for prefix, out in json.load(open(os.environ["EVAL_GH_RESPONSES"])).items():
    if line.startswith(prefix):
        sys.stdout.write(out)
        break
